:80 {
    @actuator path /actuator/*
    respond @actuator 404

    # CloudFront Origin Secret 검증
    @direct_access {
        not header X-CloudFront-Secret {env.CLOUDFRONT_SECRET}
    }
    respond @direct_access 403

    reverse_proxy app:8080 {
        health_uri      /actuator/health/upstream
        health_interval 5s
        health_timeout  3s
        fail_duration   10s
    }
}
