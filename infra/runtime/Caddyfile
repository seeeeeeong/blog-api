:80 {
    @health path /actuator/health /actuator/health/*
    handle @health {
        reverse_proxy blog-api:8080
    }

    @actuator path /actuator/*
    handle @actuator {
        respond 404
    }

    @direct_access {
        not header X-CloudFront-Secret {env.CLOUDFRONT_SECRET}
    }
    handle @direct_access {
        respond 403
    }

    @blog_ai path /api/v1/chat /api/v1/chat/* /api/v1/similar /api/v1/similar/*
    handle @blog_ai {
        reverse_proxy {env.BLOG_AI_UPSTREAM} {
            flush_interval -1
        }
    }

    handle {
        reverse_proxy blog-api:8080
    }
}
