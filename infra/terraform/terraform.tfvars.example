project_name      = "blog"
aws_region        = "ap-northeast-2"
ec2_instance_type = "t4g.micro"

# CI/CD
github_repo = "owner/blog-api"

# Domain (leave empty for CloudFront defaults)
domain_name                    = ""
cloudfront_acm_certificate_arn = ""
cloudfront_origin_secret       = "" # openssl rand -hex 32

# Database
db_password = ""

# Monitoring (leave empty to disable email alerts)
monitoring_alert_email      = ""
cpu_alarm_threshold         = 80
memory_alarm_threshold      = 85
disk_alarm_threshold        = 85
api_5xx_error_rate_threshold = 1

# SSM
ssm_parameter_prefix = "/blog/prod"
